{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**", "!src/data"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "off",
        "noProcessEnv": "error",
        "useBlockStatements": "error"
      },
      "complexity": {
        "noUselessSwitchCase": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "useAwait": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "useImportExtensions": "off",
        "noNodejsModules": "off",
        "noUnresolvedImports": "off",
        "noUnusedImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/config/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
