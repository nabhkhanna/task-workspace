{
  "scripts": {
    "prestart": "npm run migration:run",
    "start": "ts-node src/index.ts",
    "predev": "npm run migration:run",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "prepare": "husky",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome check --linter-enabled=false",
    "format:fix": "biome check --linter-enabled=false --write",
    "lint-staged": "lint-staged",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts migrations/Migration",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/data-source.ts",
    "script:migrate-db": "ts-node scripts/migrate-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@turf/turf": "^7.1.0",
    "@types/geojson": "^7946.0.15",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@swc/core": "^1.15.33",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.1",
    "@types/prompts": "^2.4.9",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.1.3",
    "prompts": "^2.4.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6"
  }
}
